#!/bin/bash
#SBATCH --job-name=hyb16x8_timing
#SBATCH -o myjob.o%j
#SBATCH -e myjob.e%j
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --partition=highmem
#SBATCH --account=CHE190065

# Timing test ONLY (NELM=30, stops after 30 SCF steps). Same INCAR/POSCAR/KPOINTS as
# Step-16x1_muref, but run the way the user's MD reference runs: 16 MPI ranks x 8 OpenMP
# threads per node instead of 128 pure-MPI ranks. 16 ranks/node is below the Intel MPI
# SHM-collective bug threshold (>=48), so I_MPI_COLL_INTRANODE=pt2pt is NOT set here.
module purge
module load intel/19.0.5.281 impi/2019.5.281
module load intel-mkl hdf5 python
module list

ulimit -s unlimited
export OMP_STACKSIZE=512m
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
PW=/anvil/projects/x-che190065/rywang/CEP-HALF/bin
runvasp="mpirun -np $SLURM_NTASKS $PW/vasp_std  > log.out"

eval $runvasp
