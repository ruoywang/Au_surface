#!/bin/bash
#SBATCH --job-name=AuCl_farm12h_standard
#SBATCH -o farm.o%j
#SBATCH -e farm.e%j
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --cpus-per-task=8
#SBATCH --time=12:00:00
#SBATCH --partition=standard
#SBATCH --account=CHE190065

# Single-node task farm for dataset_plan_v1 rev 2: queues ONCE, then production.py farm runs pending tasks of
# 05_production/queue.json back-to-back on this node (16 MPI x 8 OpenMP), sharing the queue with the other
# farm jobs through a file lock; children of accepted relaxations are generated on the fly.
module purge
module load intel/19.0.5.281 impi/2019.5.281
module load intel-mkl hdf5 python
ulimit -s unlimited
export OMP_STACKSIZE=512m
export OMP_NUM_THREADS=8
export PYTHONNOUSERSITE=1
cd /anvil/scratch/x-rywang/Au_Cl
scripts/pyrun.sh scripts/production.py farm
