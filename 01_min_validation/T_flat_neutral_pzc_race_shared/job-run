#!/bin/bash
# Race copy of T_flat_neutral_pzc/job-run, submitted to `shared` in parallel with
# the `debug`-partition submission (job 20845614), so whichever starts first wins;
# the other gets cancelled once one is actually running.
#SBATCH --job-name=Au_T_neutral_pzc_shared
#SBATCH -o myjob.o%j
#SBATCH -e myjob.e%j
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1
#SBATCH --time=02:00:00
#SBATCH --partition=shared
#SBATCH --account=CHE190065

module purge
module load intel/19.0.5.281 impi/2019.5.281
module load intel-mkl hdf5 python
module list

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
PW=/anvil/projects/x-che190065/rywang/CEP-HALF/bin
runvasp="mpirun -np $SLURM_NTASKS $PW/vasp_std  > log.out"

eval $runvasp
